# Copy to env/.env.dev for local development or env/.env.production for
# deployments, and fill in real values. Both copies are gitignored; only this
# sample is committed.

# --- server ---
# The one port everything runs on: web app, API and realtime sockets.
# Change it freely (e.g. PORT=8080); nothing else needs to know the number.
PORT=4000
# MongoDB: set the four MONGO* parts (what most hosting providers inject) and
# the server builds the connection string itself (directConnection=true, plus
# authSource=admin when a user is set). Leave user/password empty for a
# database without login.
MONGOHOST=localhost
MONGOPORT=27017
MONGOUSER=
MONGOPASSWORD=
# Alternative, used only when MONGOHOST is unset: a full connection string.
# MONGODB_URI=mongodb://localhost:27017/?directConnection=true
FOUR_CHESS_DB_NAME=four-chess
JWT_SECRET=change-me

# Who may use the admin console: emails of accounts that are already
# registered, comma-separated. They are promoted when the server starts.
ADMIN_EMAILS=

# Logging. Levels: trace, debug, info, warn, error. Defaults: debug and
# readable lines in development; info and JSON lines when NODE_ENV=production.
# LOG_LEVEL=info
# LOG_PRETTY=0
# How many proxies sit in front of the server, so logs show the real client
# IP. Defaults to 1 in production (hosting platforms add one), none otherwise.
# TRUST_PROXY=1

# Voice/video calls (WebRTC). Calls are peer-to-peer; these servers only help
# players find each other. Comma-separated lists. STUN alone works on most
# home networks; add a TURN relay so calls also connect behind strict
# firewalls and on mobile networks. Keep TURN_PASSWORD in env/.env.local.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_PASSWORD=

# --- web app (picked up by vite at build/dev time) ---
# Normally leave these unset: the app talks to the server that served it.
# Set them only to point the web app at a different server.
# VITE_API_URL=https://api.example.com
# VITE_GAME_URL=https://api.example.com

GMAIL_APP_PASSWORD=your-16-char-app-password
